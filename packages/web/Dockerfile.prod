# packages/web/Dockerfile.prod
# Imagen de produccion del frontend (Vite + React) de AlentApp (@alentapp/web).
# Multi-stage build de 3 etapas: deps -> build -> runtime (Nginx).
# Modelo de infraestructura inmutable: se construye una vez y se promueve sin
# modificaciones entre entornos. Solo la ultima etapa llega a la imagen final.
#
# Contexto de build esperado: raiz del monorepo.
#   docker build -f packages/web/Dockerfile.prod -t alentapp-web:prod .

# =============================================================================
# Stage 1: deps  (node:22-alpine)
# Instalacion determinista de las dependencias del workspace.
# =============================================================================
FROM node:22-alpine AS deps
WORKDIR /app

# Copiar SOLO los manifiestos, de lo mas estable a lo mas volatil, para
# maximizar el cache de capas: mientras los package*.json no cambien, Docker
# reutiliza node_modules y evita reinstalar al tocar codigo de la UI.
# Se incluye el manifiesto de `shared` para no provocar resoluciones de
# versiones inconsistentes entre los servicios del monorepo.
COPY package.json package-lock.json ./
COPY packages/web/package*.json ./packages/web/
COPY packages/shared/package*.json ./packages/shared/

# Build determinista anclado al lockfile (npm Workspaces resuelve los paquetes
# internos como @alentapp/shared).
RUN npm ci

# =============================================================================
# Stage 2: build  (node:22-alpine)
# Compilacion con Vite (`tsc -b && vite build`).
# =============================================================================
FROM node:22-alpine AS build
WORKDIR /app

# Reutilizar las dependencias ya instaladas en el stage `deps`.
COPY --from=deps /app/node_modules ./node_modules

# Manifiestos + codigo fuente del frontend y del paquete compartido.
COPY package.json package-lock.json ./
COPY packages/shared ./packages/shared
COPY packages/web ./packages/web

# Emite los estaticos optimizados en packages/web/dist. Este stage es efimero:
# sus capas, devDependencies y fuentes no llegan a la imagen final.
# Se ejecuta `vite build` (tal cual la parte b) del diseno), que transpila con
# esbuild sin el type-check estricto de `tsc -b`.
RUN npm exec -w packages/web -- vite build

# =============================================================================
# Stage 3: runtime  (nginx:stable-alpine)
# Servidor web dedicado para los estaticos. Sin Node.js ni node_modules.
# =============================================================================
FROM nginx:stable-alpine AS runtime

# Politica del servidor versionada aparte de la imagen (principio "Localizar
# parametros de configuracion"): se reemplaza el nginx.conf base.
COPY packages/web/nginx.conf /etc/nginx/nginx.conf

# Unicamente el output estatico del `vite build` llega a la imagen final.
COPY --from=build /app/packages/web/dist /usr/share/nginx/html

# Ejecutar como usuario no-root `nginx` (UID/GID 101, ya presente en la imagen
# oficial). Se ajusta la propiedad de los directorios que Nginx escribe.
RUN chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx /var/log/nginx \
    && touch /var/run/nginx.pid \
    && chown nginx:nginx /var/run/nginx.pid

USER nginx

EXPOSE 80

# Healthcheck autodescriptivo ante el orquestador (Compose / Swarm / K8s).
# Se usa wget (disponible en Alpine via busybox); nginx:stable-alpine no trae curl.
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
